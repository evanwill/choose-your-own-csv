---
// story.astro — interactive story player
//
// This page is a static HTML shell; all story rendering happens in the
// browser via the inline script tag at the bottom of this file.
//
// Supported URL query parameters:
//   ?story=<id>   — which configured story to load (matches config.js story id)
//   ?id=<storyId> — which story entry (row) to display (matches the CSV `id` column)
//   ?csv=<url>    — (development mode only) override the CSV URL
//
// Navigation flow:
//   1. Parse query string to find which story / entry to show.
//   2. Look up the CSV URL from the embedded site config
//      (or use the ?csv= override in dev mode).
//   3. Check sessionStorage for a cached parse result.
//   4. If not cached, fetch the CSV and parse it with PapaParse.
//   5. Find the matching row, render title + text (basic Markdown) + choices.
//   6. Each choice link updates the URL and re-renders the page.
import Layout from '../layouts/Layout.astro';
import { siteFooter, stories, developmentMode } from '../config.js';

// Pass the base URL so client-side links work in subdirectory deployments.
// Normalized to always have a trailing slash so path concatenation works correctly.
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<Layout title="Story">
  <div class="story-container">

    <!-- Story title shown at the top of the player (updated by JS) -->
    <p id="story-loading">Loading story…</p>
    <p id="story-error" style="display:none"></p>

    <!-- Story content (hidden until data is ready) -->
    <article id="story-page" style="display:none" aria-live="polite">
      <h1 class="story-page-title" id="entry-title"></h1>
      <!-- Optional illustration (populated by JS when image_link is present) -->
      <figure id="entry-image" style="display:none">
        <img id="entry-img" src="" alt="">
      </figure>
      <div class="story-page-text" id="entry-text"></div>

      <!-- Choices section (hidden when there are none) -->
      <section id="choices-section" style="display:none">
        <ul class="choices-list" id="choices-list"></ul>
      </section>

      <!-- Dead-end message (shown when there are no choices) -->
      <p class="story-end" id="story-end" style="display:none">
        ☞ The End.
      </p>

      <!-- Navigation: restart link -->
      <nav class="story-nav" id="story-nav"></nav>
    </article>

  </div>

  <span slot="footer">{siteFooter}</span>

<!--
  PapaParse — lightweight CSV parser
  https://www.papaparse.com/
-->
<script src={`${base}assets/lib/papaparse.min.js`}></script>

<script id="story-page-data" type="application/json" set:html={JSON.stringify({ base, stories, developmentMode })}></script>

<script>
import { loadStoryRows, rememberLocalStory } from '../scripts/story-loader.js';
import { renderMarkdown, getChoices, parseChoice, resolveCsvUrl as resolveCsvUrlShared } from '../scripts/story-shared.js';

// ============================================================
// choose-your-own-csv — story player script
// ============================================================

const pageDataEl = document.getElementById('story-page-data');
const pageData = pageDataEl ? JSON.parse(pageDataEl.textContent || '{}') : {};
const SITE_CONFIG = {
  stories: Array.isArray(pageData.stories) ? pageData.stories : [],
  developmentMode: Boolean(pageData.developmentMode),
};
const base = pageData.base || '/';

// ------------------------------------------------------------
// DOM helpers
// ------------------------------------------------------------
function show(el) { el.style.display = ''; }
function hide(el) { el.style.display = 'none'; }

function showError(message) {
  const loadingEl = document.getElementById('story-loading');
  const errorEl   = document.getElementById('story-error');
  if (loadingEl) hide(loadingEl);
  if (errorEl)   { errorEl.innerHTML = message; show(errorEl); }
}

// ------------------------------------------------------------
// Query string helpers
// ------------------------------------------------------------
function getParam(name) {
  return new URLSearchParams(window.location.search).get(name) || '';
}

/**
 * Build a URL for a story entry link.
 * Preserves the ?story= and ?csv= params so navigation stays self-contained.
 */
function entryUrl(entryId) {
  const params = new URLSearchParams(window.location.search);
  params.set('id', entryId);
  return `${window.location.pathname}?${params.toString()}`;
}

// ------------------------------------------------------------
// Resolve the CSV URL to use
// Priority:
//   1. ?csv= param (only in development mode)
//   2. CSV URL from the configured story matching ?story= param
//   3. First configured story (fallback)
//
// If the resolved CSV path starts with '/' (site-relative), the base URL is
// prepended so assets under public/ work in subdirectory deployments.
// ------------------------------------------------------------
function resolveCsvUrl() {
  return resolveCsvUrlShared({
    developmentMode: SITE_CONFIG.developmentMode,
    stories: SITE_CONFIG.stories,
    storyParam: getParam('story'),
    csvParam: getParam('csv'),
    base,
  });
}

// ------------------------------------------------------------
// Render a single story entry from parsed CSV rows
// ------------------------------------------------------------
function renderEntry(rows, entryId) {
  const loadingEl        = document.getElementById('story-loading');
  const storyPageEl      = document.getElementById('story-page');
  const titleEl          = document.getElementById('entry-title');
  const textEl           = document.getElementById('entry-text');
  const choicesSectionEl = document.getElementById('choices-section');
  const choicesListEl    = document.getElementById('choices-list');
  const storyEndEl       = document.getElementById('story-end');
  const storyNavEl       = document.getElementById('story-nav');

  // Default to the first row if no id is specified
  const targetId = entryId || (rows.length > 0 ? rows[0].id : null);

  if (!targetId) {
    showError('<strong>Error:</strong> The story CSV appears to be empty.');
    return;
  }

  // Find the matching row
  const entry = rows.find(r => String(r.id).trim() === String(targetId).trim());

  if (!entry) {
    showError(
      `<strong>Error:</strong> Could not find a story entry with id <code>${targetId}</code>. ` +
      `Check that the <code>id</code> values in your CSV are correct.`
    );
    return;
  }

  // Detect the info/cover row (id === "info") — used by several sections below
  const isCover = String(entry.id).trim() === 'info';
  storyPageEl.classList.toggle('story-cover', isCover);

  // ---- Title ----
  titleEl.textContent = entry.title || '(no title)';

  // ---- Optional image ----
  const imageFigureEl = document.getElementById('entry-image');
  const imgEl         = document.getElementById('entry-img');
  const imageLink = (entry.image_link || '').trim();
  if (imageLink) {
    // Only allow http/https URLs or site-relative paths to prevent injection
    const safeImage = /^(https?:\/\/|\/|\.\/)/.test(imageLink);
    if (safeImage) {
      imgEl.src = imageLink;
      imgEl.alt = (entry.alt_text || '').trim();
      // Cover images get a special class for extra visual weight
      imageFigureEl.className = isCover ? 'entry-image entry-image--cover' : 'entry-image';
      show(imageFigureEl);
    } else {
      hide(imageFigureEl);
    }
  } else {
    hide(imageFigureEl);
  }

  // ---- Body text (Markdown) ----
  textEl.innerHTML = renderMarkdown(entry.text || '');

  // ---- Choices ----
  const choices = getChoices(entry);

  choicesListEl.innerHTML = '';

  if (isCover) {
    // Cover page: render choice_1 as a prominent "Begin" button
    const choice1 = (entry.choice_1 || '').trim();
    if (choice1) {
      const { label, targetId: targetEntryId } = parseChoice(choice1, 'Begin Story');
      const a = document.createElement('a');
      a.className   = 'story-begin-btn';
      a.href        = entryUrl(targetEntryId);
      a.textContent = label;
      choicesListEl.appendChild(a);
      show(choicesSectionEl);
    } else {
      hide(choicesSectionEl);
    }
    hide(storyEndEl);
  } else if (choices.length > 0) {
    choices.forEach(choice => {
      const { label, targetId: targetEntryId } = parseChoice(choice);

      const li = document.createElement('li');
      const a  = document.createElement('a');
      a.className = 'choice-link';
      a.href      = entryUrl(targetEntryId);
      a.textContent = label;
      li.appendChild(a);
      choicesListEl.appendChild(li);
    });

    show(choicesSectionEl);
    hide(storyEndEl);
  } else {
    // Dead-end — no choices
    hide(choicesSectionEl);
    show(storyEndEl);
  }

  // ---- Navigation ----
  // Determine the first entry id so we can offer a "Restart" link
  const firstId = rows.length > 0 ? rows[0].id : null;
  storyNavEl.innerHTML = '';
  if (firstId && String(firstId).trim() !== String(targetId).trim()) {
    const restart = document.createElement('a');
    restart.href = entryUrl(firstId);
    restart.textContent = '↩ Restart story';
    storyNavEl.appendChild(restart);
    storyNavEl.appendChild(document.createTextNode(' · '));
  }
  const homeLink = document.createElement('a');
  homeLink.href = base;
  homeLink.textContent = '⌂ Home';
  storyNavEl.appendChild(homeLink);

  // Share button — cover page only
  if (isCover) {
    // Preserve only the param that identifies the story (?story= for
    // configured stories, ?csv= for dev-mode CSV links) for both the
    // share and print links, stripping any ?id= navigation state.
    const storyId = getParam('story');
    const csvId   = getParam('csv');

    storyNavEl.appendChild(document.createTextNode(' · '));
    const shareBtn = document.createElement('button');
    shareBtn.className = 'story-share-btn';
    shareBtn.setAttribute('aria-label', 'Copy link to story');
    shareBtn.innerHTML =
      '<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg>' +
      ' <span class="share-label">Share</span>';
    shareBtn.addEventListener('click', () => {
      let shareUrl;
      if (storyId) {
        shareUrl = `${window.location.origin}${window.location.pathname}?story=${encodeURIComponent(storyId)}`;
      } else if (csvId) {
        shareUrl = `${window.location.origin}${window.location.pathname}?csv=${encodeURIComponent(csvId)}`;
      } else {
        shareUrl = `${window.location.origin}${window.location.pathname}`;
      }
      const onCopied = () => {
        shareBtn.querySelector('.share-label').textContent = 'Copied!';
        shareBtn.classList.add('story-share-btn--copied');
        setTimeout(() => {
          shareBtn.querySelector('.share-label').textContent = 'Share';
          shareBtn.classList.remove('story-share-btn--copied');
        }, 2000);
      };
      if (navigator.clipboard) {
        navigator.clipboard.writeText(shareUrl).then(onCopied).catch(() => {});
      } else {
        try {
          const ta = document.createElement('textarea');
          ta.value = shareUrl;
          ta.style.cssText = 'position:fixed;opacity:0;pointer-events:none';
          document.body.appendChild(ta);
          ta.select();
          document.execCommand('copy');
          document.body.removeChild(ta);
          onCopied();
        } catch (_) {}
      }
    });
    storyNavEl.appendChild(shareBtn);

    // Print button — links to the paged.js print view, preserving the
    // same story-identifying param as the share link.
    storyNavEl.appendChild(document.createTextNode(' · '));
    const printParams = new URLSearchParams();
    if (storyId) printParams.set('story', storyId);
    else if (csvId) printParams.set('csv', csvId);
    const printQs = printParams.toString();
    const printLink = document.createElement('a');
    printLink.className = 'story-print-btn';
    printLink.href = `${base}story/print/${printQs ? `?${printQs}` : ''}`;
    printLink.innerHTML =
      '<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 6 2 18 2 18 9"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect x="6" y="14" width="12" height="8"/></svg>' +
      ' <span>Print</span>';
    storyNavEl.appendChild(printLink);
  }

  // ---- Show the card ----
  if (loadingEl) hide(loadingEl);
  show(storyPageEl);
}

// ------------------------------------------------------------
// Main entry point — runs when the DOM is ready
// ------------------------------------------------------------
async function init() {
  const csvUrl  = resolveCsvUrl();
  const entryId = getParam('id');
  const shouldRememberStory = Boolean(getParam('csv'));

  if (!csvUrl) {
    showError(
      'No story CSV configured. ' +
      'Please edit <code>src/config.js</code> and add at least one story, ' +
      `or use the <a href="${base}">home page</a> to load a CSV.`
    );
    return;
  }

  try {
    const rows = await loadStoryRows(csvUrl);
    if (shouldRememberStory) {
      rememberLocalStory(csvUrl, rows);
    }
    renderEntry(rows, entryId);
  } catch (error) {
    if (error?.message === 'The CSV is missing required columns.') {
      showError(
        '<strong>Error:</strong> The CSV is missing required columns. ' +
        'Make sure the first row contains at least: <code>id, title, text, choice_1</code>.'
      );
      return;
    }

    if (error?.message === 'The CSV is empty or could not be parsed.') {
      showError(
        `<strong>Error:</strong> The CSV loaded from <code>${csvUrl}</code> ` +
        `is empty or could not be parsed. Check the URL and make sure the file ` +
        `follows the <a href="${base}docs/spreadsheet_setup.md">spreadsheet format</a>.`
      );
      return;
    }

    if (error?.message === 'CSV parser unavailable.') {
      showError('<strong>Error:</strong> CSV parser unavailable.');
      return;
    }

    showError(
      `<strong>Error loading CSV:</strong> ${(error && error.message) || error}. ` +
      `Check that the URL is publicly accessible and try again. ` +
      `(URL: <code>${csvUrl}</code>)`
    );
  }
}

// Run once the DOM is ready
if (document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', init);
} else {
  init();
}
</script>

</Layout>